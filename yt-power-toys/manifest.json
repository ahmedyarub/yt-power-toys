{
  "manifest_version": 2,
  "name": "YT Power Toys",
  "version": "1.0.1",
  "description": "Long-press rewind, hover previews while Picture-in-Picture is playing, and a Windows volume guard for YouTube.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-power-toys@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["nativeMessaging", "storage"],
  "background": { "scripts": ["settings.js", "background.js"], "persistent": true },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "browser_action": { "default_title": "YT Power Toys", "default_icon": "icons/icon.svg" },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.youtube-nocookie.com/*"
      ],
      "js": [
        "settings.js",
        "features/long-press-rewind.js",
        "features/hover-preview.js",
        "features/volume-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
